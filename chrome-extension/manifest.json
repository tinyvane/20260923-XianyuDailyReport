{
  "manifest_version": 3,
  "name": "闲鱼商品监控日报连接器",
  "version": "0.1.0",
  "description": "在当前 Chrome 登录会话中读取闲鱼页面可见的卖家和商品数据。",
  "permissions": ["tabs", "scripting", "cookies"],
  "host_permissions": [
    "https://www.goofish.com/*",
    "https://goofish.com/*",
    "http://127.0.0.1:5055/*"
  ],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://127.0.0.1:5055/*"],
    "js": ["bridge.js"],
    "run_at": "document_start"
  }],
  "action": {"default_title": "闲鱼日报连接器"}
}
